# MongoDB connection (the same database the scraper writes to)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?appName=mandi-review
MONGODB_DB=Price
# v2 collections live next to v1 in Price with this prefix (leave empty if v2 has its own database, e.g. PriceV2)
V2_COLLECTION_PREFIX=v2_

# Who can sign in: name:password:role, comma-separated.
# role = admin | reviewer (can change data) | viewer (read only)
APP_USERS=kishar:change-me-long-password:admin,expert:another-long-password:reviewer

# Random string, at least 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Optional: only if your collections use other names
# LISTINGS_COLLECTION=listings
# PRICE_COLLECTION=price_records
# ALL_MANDI_COLLECTION=available_mandi
# CROPS_COLLECTION=crops
# PRODUCTS_COLLECTION=products
# CROP_NAMES_COLLECTION=crop_names
# MANDI_NAMES_COLLECTION=mandi_names
# STATES_COLLECTION=states
# INGESTION_RUNS_COLLECTION=ingestion_runs
# REVIEW_ITEMS_COLLECTION=review_items
# AUDIT_COLLECTION=audit_log
